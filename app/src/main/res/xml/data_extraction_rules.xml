<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 的备份/设备迁移规则：默认不备份任何应用数据。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
